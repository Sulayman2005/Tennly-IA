# Fichier versionné : valeurs par défaut / non secrètes.
# Toute valeur réelle (mots de passe, clés) va dans .env.local (jamais commité).

APP_ENV=dev
APP_SECRET=change_me_in_env_local

###> doctrine/doctrine-bundle ###
# Base créée pour le développement local de cette maquette :
#   sudo -u postgres psql -c "CREATE USER veritennis WITH PASSWORD 'veritennis' CREATEDB;"
#   sudo -u postgres psql -c "CREATE DATABASE veritennis OWNER veritennis;"
DATABASE_URL="postgresql://veritennis:veritennis@127.0.0.1:5432/veritennis?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_in_env_local
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Origine du frontend Vue en développement (Vite)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> stripe ###
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
###< stripe ###

###> app ###
# URL du frontend Vue en développement, utilisée pour les redirections Stripe
# Checkout (success_url / cancel_url, voir StripeCheckoutService).
FRONTEND_BASE_URL=http://localhost:5173
###< app ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=b1511ecc2849d57ef94198159b10cf52
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
